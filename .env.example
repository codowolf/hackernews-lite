# Copy this file to .env and fill it in. .env is never checked in.
#
# Optional. Powers the cheap comment picks and the agree/disagree reaction (see README, "Claude
# and Jev"). Without it the app still runs and summarizes articles, but shows no comment picks.
# Docs: https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Only if you set provider = "anthropic" in config.toml (pay-as-you-go instead of `claude -p`).
# ANTHROPIC_API_KEY=
